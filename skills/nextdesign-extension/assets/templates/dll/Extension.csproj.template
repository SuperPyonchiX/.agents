<Project Sdk="Microsoft.NET.Sdk">

  <!--
    <拡張機能名>.csproj として保存する。値は V3.x で実機確認したもの。
    V4.x 以降は TargetFramework と NuGet の版を docBase の
    docs/getting-started/dev-with-vs/create-vs-project で確かめてから書き換える。
  -->
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 新しい SDK で古い TargetFramework をビルドするときのサポート終了警告を止める -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <!--
    NextDesign.Core / NextDesign.Desktop の参照元を切り替える。
    - 既定: NuGet の公開版を参照する
    - -p:NextDesignDir="<インストール先>" を渡したとき: インストール先の DLL を直接参照する
    どちらも実行時は Next Design 本体の DLL を使うので、出力には含めない。
  -->
  <ItemGroup Condition="'$(NextDesignDir)' != ''">
    <!-- NuGet の NextDesign.Desktop が宣言している WPF 参照を補う。無いと WindowsBase の版競合警告が出る -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <Reference Include="NextDesign.Core">
      <HintPath>$(NextDesignDir)\NextDesign.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NextDesign.Desktop">
      <HintPath>$(NextDesignDir)\NextDesign.Desktop.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(NextDesignDir)' == ''">
    <PackageReference Include="NextDesign.Core" Version="3.1.3.30714" ExcludeAssets="runtime" />
    <PackageReference Include="NextDesign.Desktop" Version="3.1.3.30714" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="resources\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
