// Next Design エクステンション エントリポイント（C# スクリプト）
//
// 制約:
//   - manifest.json の main に指定できるファイルは1つだけ。全ハンドラをここに書く
//   - クラス宣言は書かない。トップレベルにメソッドを並べる
//   - using は自動で補われない。使った型の using を必ず書く
//     （application ライフサイクルで using が不足すると Next Design が起動しなくなる）
//   - デバッガは使えない。Output.WriteLine が唯一の手がかりになる
//   - 変更は Next Design を再起動するまで反映されない

using NextDesign.Core;
using NextDesign.Desktop;
using NextDesign.Extension;
using System;
using System.Collections.Generic;
using System.Linq;

// 出力ウィンドウのカテゴリ。拡張機能名で固定すると自分のログを絞り込める
const string LogCategory = "MyExtension";

//----------------------------------------------------------------------
// コマンドハンドラ
// manifest.json の commands[].execFunc と関数名を完全一致させる
//----------------------------------------------------------------------

public void Run(ICommandContext context, ICommandParams parameters)
{
    try
    {
        Output.WriteLine(LogCategory, "処理を開始します");

        var project = App.Workspace.CurrentProject;
        if (project == null)
        {
            App.Window.UI.ShowInformationDialog(
                "プロジェクトを開いてから実行してください", "My Extension");
            return;
        }

        // ここに処理を書く

        Output.WriteLine(LogCategory, "処理が完了しました");
        App.Window.UI.ShowInformationDialog("処理が完了しました", "My Extension");
    }
    catch (Exception e)
    {
        // 握りつぶさない。握りつぶすと「押しても無反応」にしか見えず原因に辿り着けない
        Output.WriteLine(LogCategory, string.Format("エラー: {0}", e.Message));
        App.Window.UI.ShowInformationDialog(e.Message, "My Extension - エラー");
    }
}

