{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "design-index",
  "description": "Next Design の詳細設計を、以降の全工程が参照する唯一の形に正規化したもの。フェーズ0で work/design-index.json として作る。",
  "type": "object",
  "required": ["source", "classes", "open_questions"],
  "properties": {
    "source": {
      "type": "string",
      "description": "取り込み元の HTML ファイルパス"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 のタイムスタンプ"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "functions"],
        "properties": {
          "name": { "type": "string" },
          "namespace": {
            "type": "string",
            "description": "見出し階層から導いた名前空間。無ければ空文字"
          },
          "brief": { "type": "string" },
          "base_classes": { "type": "array", "items": { "type": "string" } },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": {
                  "type": "string",
                  "description": "読み取れなかった場合は \"unknown\" とし、open_questions に積む"
                },
                "visibility": { "enum": ["public", "protected", "private"] },
                "brief": { "type": "string" }
              }
            }
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "return_type", "parameters", "visibility"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "クラス名::関数名。オーバーロードがある場合のみ クラス名::関数名(引数型のカンマ区切り)。全工程の突合キーなので途中で変えない"
                },
                "name": { "type": "string" },
                "return_type": { "type": "string" },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "type"],
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string" },
                      "direction": { "enum": ["in", "out", "inout"] },
                      "range": {
                        "type": "string",
                        "description": "有効範囲。境界値テストの材料。設計に記載が無ければ空"
                      }
                    }
                  }
                },
                "visibility": { "enum": ["public", "protected", "private"] },
                "is_const": { "type": "boolean" },
                "is_virtual": { "type": "boolean" },
                "brief": { "type": "string" },
                "preconditions": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "シーケンス図の呼び出し順や設計記述から導いた事前条件。Doxygen の @pre になる"
                },
                "return_values": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": { "type": "string" },
                      "meaning": { "type": "string" }
                    }
                  },
                  "description": "Doxygen の @retval と、異常系テスト観点の出典になる"
                }
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target"],
              "properties": {
                "target": { "type": "string", "description": "依存先クラス名" },
                "multiplicity": { "type": "string", "description": "1 / 0..1 / 0..* など" },
                "mockable": {
                  "type": "boolean",
                  "description": "フェーズ4でモック化する対象か"
                }
              }
            }
          }
        }
      }
    },
    "sequences": {
      "type": "array",
      "description": "シーケンス図から取れた呼び出し順。テスト観点の区分「相互作用」の出典になる",
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "properties": {
          "name": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "order": { "type": "integer" },
                "from": { "type": "string" },
                "to": { "type": "string" },
                "call": { "type": "string" },
                "note": { "type": "string", "description": "分岐・代替フロー・ループの条件" }
              }
            }
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "description": "読み取れなかった点、矛盾していた点。空でない状態でフェーズ1に進んではいけない",
      "items": {
        "type": "object",
        "required": ["where", "question"],
        "properties": {
          "where": { "type": "string", "description": "対象の関数 id やクラス名" },
          "question": { "type": "string" }
        }
      }
    }
  }
}
